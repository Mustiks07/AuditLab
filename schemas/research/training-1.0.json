{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mustiks07/AuditLab/schemas/research/training-1.0.json",
  "title": "AuditLab public research training",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "artifact_id",
    "source_sha",
    "protocol_id",
    "provenance",
    "curriculum_id",
    "kind",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_kind": {
      "const": "training"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "source_sha": {
      "type": "string",
      "minLength": 1
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "measured",
            "test_double",
            "dev_fixture"
          ]
        }
      }
    },
    "curriculum_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "state": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
